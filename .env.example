# Copy to .env for local dev.
# Postgres 16+ is required
DATABASE_URL="postgresql://cursus:cursus@localhost:5432/cursus?schema=public"

# Session signing key for dashboard auth (generate with: openssl rand -base64 32).
SESSION_SECRET="change-me-in-production"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"

# Prefilled as the organization-name suggestion during onboarding (editable).
BOOTSTRAP_ORG_NAME="sagea"

# Object storage (S3 API) for large bytes. Local dev against compose MinIO:
#   docker compose up -d minio
# Self-host composes MinIO automatically. For AWS/R2/GCS-XML, point these
# at your provider instead. Unset endpoint/creds disables byte features
# (media) with a clear 503 — metadata-only flows keep working.
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="cursus-media"
S3_REGION="us-east-1"
S3_ACCESS_KEY="cursus"
S3_SECRET_KEY="cursus-minio-secret"
S3_FORCE_PATH_STYLE="true"

# SSO via OIDC (optional, all-or-nothing). When set, the login page gains
# "Sign in with SSO" bridged into the regular cookie session. JIT-provisions
# MEMBERs into OIDC_ORG_SLUG (or the single org when unset and unique).
# OIDC_ALLOWED_DOMAINS is a comma list (empty = any verified email).
# OIDC_REDIRECT_URI overrides the derived callback URL (needed behind proxies).
# OIDC_ISSUER="https://accounts.google.com"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_ORG_SLUG=""
# OIDC_ALLOWED_DOMAINS=""
# OIDC_REDIRECT_URI=""
