// Cursus — Prisma schema (source of truth for the data model).
//
// Design notes (do not "fix" without understanding the query budget):
// - Metric uses BigInt autoincrement PK, NOT cuid(). It is the highest-volume
//   table by orders of magnitude; a sequential integer PK is smaller and faster
//   to index than text CUIDs. Every other table uses cuid() for safer,
//   non-guessable public-facing IDs (run URLs, project URLs). Deliberate
//   asymmetry, not inconsistency.
// - Metric rows are insert-only, never updated (no updatedAt on Metric).
// - config/summary are Json to avoid per-metric-key migrations.
// - One org per user in v1 (User.orgId is a plain required field, no join
//   table) — keeps every auth check a single-column comparison.
// - Postgres is required, not optional: joins + transactions for
//   runs/metrics/projects/orgs/roles. No relational-DB-free variant.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  MEMBER
}

enum RunStatus {
  RUNNING
  FINISHED
  CRASHED
  KILLED
}

model Org {
  id        String    @id @default(cuid())
  name      String
  // URL slug for /[org]/... dashboard routes. Path-based, not
  // subdomain — simpler for self-hosters behind arbitrary reverse proxies.
  slug      String    @unique
  createdAt DateTime  @default(now())
  users     User[]
  projects  Project[]
  apiKeys   ApiKey[]
  groups    Group[]
  auditEvents AuditEvent[]
}

// Deployment-wide singleton flags (one row, id = "global"). Owns the
// onboarding kill-switch (checked before any
// org exists, so it cannot live on Org).
model GlobalSettings {
  id                 String  @id
  onboardingDisabled Boolean @default(false)
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String   @unique
  // Display name from onboarding; "" for rows predating the field.
  name         String   @default("")
  // Public profile fields (editable by the owner; email/name are not).
  bio          String   @default("")
  location     String   @default("")
  website      String   @default("")
  twitter      String   @default("")
  github       String   @default("")
  passwordHash String
  role         Role     @default(MEMBER)
  createdAt    DateTime  @default(now())
  apiKeys      ApiKey[]
  runsCreated  Run[]
  artifactsCreated Artifact[]
  groupsCreated Group[]
  groupMemberships GroupMember[]
  auditActions AuditEvent[]

  @@index([orgId])
}

model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  org        Org       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash    String    @unique // never store plaintext; show once on creation
  label      String // human-readable, e.g. "training-box-1"
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime? // soft revoke, never hard-delete (audit trail)

  @@index([orgId])
  @@index([userId])
}

model Project {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  slug      String
  name      String
  // Optional group scope. NULL = org-wide public project (visible to every
  // member, the pre-groups behavior). Non-null = visible only to group
  // members and super admins; runs inherit their project's visibility.
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  runs      Run[]
  artifacts Artifact[]

  @@unique([orgId, slug])
  @@index([groupId])
}

model Run {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  // Free-text notes (W&B "Add notes..." column). Edited on the run detail
  // Overview tab, displayed truncated in the run table.
  notes       String    @default("")
  status      RunStatus @default(RUNNING)
  config      Json      @default("{}")
  tags        String[]  @default([])
  // Denormalized last-known value per metric key, for fast list views.
  // Keeps the run-list view O(runs), not O(runs × metrics) — new
  // "at a glance" run-list columns must update summary where metrics are
  // written, not join Metric at read time.
  summary     Json      @default("{}")
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  updatedAt   DateTime  @updatedAt // heartbeat target for stale-run detection

  metrics     Metric[]
  artifactsProduced ArtifactVersion[]
  media       MediaItem[]


  @@index([projectId])
  @@index([status])
}

model Metric {
  // See header comment: sequential PK is deliberate for this hot table.
  id       BigInt   @id @default(autoincrement())
  runId    String
  run      Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  key      String
  step     Int
  value    Float
  wallTime DateTime @default(now())

  @@index([runId, key, step])
}

// --- Groups (scoped visibility) --------------------------------------------
// A group is a named subset of an org with its own members and runs.
// Visibility rule (enforced in lib/groups.ts runVisibilityFilter, applied on
// EVERY run read path): org-wide runs (groupId NULL) are visible to all
// members; grouped runs only to group members and super admins. This is the
// entire permissions model — no custom roles, no per-project ACLs.

model Group {
  id          String   @id @default(cuid())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  description String   @default("")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  members     GroupMember[]
  projects    Project[]

  @@unique([orgId, slug])
  @@index([orgId])

  @@map("groups")
}

model GroupMember {
  groupId String
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt DateTime @default(now())

  @@id([groupId, userId])
  @@index([userId])

  @@map("group_members")
}

// --- Audit log -------------------------------------------------------------
// Append-only record of sensitive actions (today: API key lifecycle —
// created, rotated, revoked). Powers the History dialog so revoked keys
// don't clutter the active-keys table. Rows are never updated or deleted
// by the app; actor attribution uses Restrict (like runs) since hard-deleting
// a user reassigns their audit entries to the acting admin first.

model AuditEvent {
  id         String   @id @default(cuid())
  orgId      String
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  targetType String
  targetId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([orgId, createdAt])
}

// --- Artifacts (v1, scoped) ------------------------------------------------
// Run-attached, versioned files (checkpoints, datasets, logs). What this is
// NOT: no aliases, no lineage graph, no model registry linking — those are
// deferred, and this schema does not pretend otherwise (no alias/edge
// tables). File bytes live in Postgres (bytea) to keep self-hosting to one
// database; practical cap ~100MB/file enforced at upload (see lib/artifacts).
// An S3-compatible backend is the documented v2 escape hatch.

// --- Media (images) ----------------------------------------------------------
// Logged images, key/step addressed like metrics. Bytes live in object
// storage (see lib/storage.ts) — Postgres holds metadata only. Two-phase
// upload: PENDING at URL issue, COMPLETED after the client PUTs + confirms;
// the viewer only lists COMPLETED. Re-logging (run,key,step) overwrites the
// same deterministic object key, so re-uploads can never leak storage.

enum MediaStatus {
  PENDING
  COMPLETED
}

model MediaItem {
  id         String      @id @default(cuid())
  runId      String
  run        Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  key        String
  step       Int
  mime       String
  sizeBytes  Int
  storageKey String
  status     MediaStatus @default(PENDING)
  createdAt  DateTime    @default(now())

  @@unique([runId, key, step])
  @@index([runId, status, step])
}

model Artifact {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        String   @default("model")
  description String   @default("")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  versions    ArtifactVersion[]

  @@unique([projectId, name])
  @@index([projectId])
}

model ArtifactVersion {
  id            String   @id @default(cuid())
  artifactId    String
  artifact      Artifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  version       Int
  // sha256 over sorted "path:digest" pairs — deterministic, no extra reads.
  digest        String
  sizeBytes     BigInt
  fileCount     Int
  description   String   @default("")
  createdByRunId String?
  // Run deletion keeps artifact history (SetNull, not Cascade).
  createdByRun  Run?     @relation(fields: [createdByRunId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  files         ArtifactFile[]

  @@unique([artifactId, version])
  @@index([artifactId])
  @@index([createdByRunId])
}

model ArtifactFile {
  id        String   @id @default(cuid())
  versionId String
  version   ArtifactVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  path      String
  sizeBytes BigInt
  digest    String   // sha256 hex of the bytes
  data      Bytes

  @@unique([versionId, path])
  @@index([versionId])
}
